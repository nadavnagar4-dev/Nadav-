{
  "name": "macanki",
  "productName": "MacAnki",
  "version": "1.0.0",
  "description": "A macOS-style flashcard app with spaced repetition, inspired by Anki.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0",
    "fflate": "^0.8.3",
    "png2icons": "^2.0.1"
  },
  "build": {
    "appId": "com.nadav.macanki",
    "productName": "MacAnki",
    "mac": {
      "category": "public.app-category.education",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "files": [
      "main.js",
      "preload.js",
      "store.js",
      "apkg.js",
      "renderer/**/*",
      "node_modules/**/*"
    ]
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "fzstd": "^0.1.1",
    "sql.js": "^1.14.2"
  }
}
